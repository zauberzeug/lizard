menu "Zeug BLE command module"

config ZZ_BLE_COM_SVC_UUID
    string
    prompt "Service UUID"
    default "23014ccc-4677-4864-b4c1-8f772b373fac"
    help
        The component defines a single BLE service; this is its UUID. Within the service two characteristics are defined, one writable (for receiving commands) and one readable (for sending replies).

config ZZ_BLE_COM_CHR_UUID
    string
    prompt "Command characteristic UUID"
    default "37107598-7030-46d3-b688-e3664c1712f0"
    help
        UUID of the writable characteristic for receiving commands.

config ZZ_BLE_COM_SEND_CHR_UUID
    string
    prompt "Reply characteristic UUID"
    default "19f91f52-e3b1-4809-9d71-bc16ecd81069"
    help
        UUID of the readable characteristic. Replies are always only sent via notifications, so do not perform reads on it.

config ZZ_BLE_COM_CONSOLE_IN_CHR_UUID
    string
    prompt "Console input characteristic UUID"
    default "75cdc16b-212b-4176-8bb8-4222f21cc826"
    help
        UUID of the writable characteristic that takes console lines as a byte stream, each line terminated by a newline.

config ZZ_BLE_COM_CONSOLE_OUT_CHR_UUID
    string
    prompt "Console output characteristic UUID"
    default "f8f511b2-1401-4e28-82f1-ad753df3b750"
    help
        UUID of the characteristic that streams every console line via notifications to an authenticated central.

config ZZ_BLE_COM_CONSOLE_FLOW_CHR_UUID
    string
    prompt "Console flow characteristic UUID"
    default "d1e7616c-a8ac-4ec8-9c49-3ae32a008a89"
    help
        UUID of the characteristic that notifies how many console input bytes and lines the robot has processed, so that a sender can keep its writes within the robot's queue.

config ZZ_BLE_DEV_PIN
    int "Developer PIN"
    range 0 999999
    help
        Hardcoded developer PIN for system access (numeric, 0-999999). This PIN provides administrative access to the device.

endmenu
