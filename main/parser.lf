# On the ESP32, keep the functions that every parse runs through in IRAM,
# so parsing a line does not wait for flash cache refills.
# Needs ESP-IDF 5.3.6 or newer: the ldgen of older versions cannot read the section list of libmain.a
# and skips these entries without a warning. build.py and compile.sh set LDGEN_CHECK_MAPPING, which turns
# an entry that matches no function into a build error.
if IDF_TARGET_ESP32 = y:
    [mapping:parser]
    archive: libmain.a
    entries:
        parser:owl_tree_create_from_string (noflash_text)
        parser:owl_tree_create_with_options (noflash_text)
        parser:owl_tree_create_empty (noflash_text)
        parser:parse_string (noflash_text)
        parser:owl_default_tokenizer_advance (noflash_text)
        parser:read_keyword_token (noflash_text)
        parser:fill_run_states (noflash_text)
        parser:build_parse_tree (noflash_text)
        parser:action_table_lookup (noflash_text)
        parser:apply_actions (noflash_text)
        parser:construct_begin (noflash_text)
        parser:construct_action_apply (noflash_text)
        parser:construct_node_alloc (noflash_text)
        parser:construct_expression_alloc (noflash_text)
        parser:construct_expression_should_reduce (noflash_text)
        parser:construct_expression_reduce (noflash_text)
        parser:construct_finish (noflash_text)
        parser:construct_node_free (noflash_text)
        parser:construct_expression_free (noflash_text)
        parser:finish_node (noflash_text)
        parser:finish_token (noflash_text)
        parser:rule_lookup (noflash_text)
        parser:fixity_associativity_precedence_lookup (noflash_text)
        parser:left_right_operand_slots_lookup (noflash_text)
